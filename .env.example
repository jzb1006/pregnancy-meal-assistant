# 数据库配置
DB_URL=jdbc:mysql://localhost:3306/pregnancy_meal?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# 阿里云AI配置
ALI_AI_KEY=your-ali-ai-api-key-here

# 微信小程序配置
WX_MINIAPP_APPID=your_wechat_appid
WX_MINIAPP_SECRET=your_wechat_secret

# JWT配置（密钥至少32字符）
JWT_SECRET=your-256-bit-secret-key-change-in-production-environment-at-least-32-characters-long
JWT_EXPIRATION=604800000
