# ============================================
# MySQL 容器配置（docker-compose 方式使用）
# ============================================
MYSQL_ROOT_PASSWORD=your_strong_root_password_here
MYSQL_DATABASE=pregnancy_meal
MYSQL_USER=app_user
MYSQL_PASSWORD=your_strong_app_password_here

# ============================================
# 应用数据库连接配置（docker run 单独使用）
# ============================================
DB_URL=jdbc:mysql://mysql:3306/pregnancy_meal?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=app_user
DB_PASSWORD=your_strong_app_password_here

# ============================================
# 阿里云AI配置
# ============================================
ALI_AI_KEY=your-ali-ai-api-key-here

# 微信小程序配置
WX_MINIAPP_APPID=your_wechat_appid
WX_MINIAPP_SECRET=your_wechat_secret

# JWT配置（密钥至少32字符）
JWT_SECRET=your-256-bit-secret-key-change-in-production-environment-at-least-32-characters-long
JWT_EXPIRATION=604800000
